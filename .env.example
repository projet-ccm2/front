# Twitch Client ID from Twitch Developer Console
VITE_TWITCH_CLIENT_ID=your_twitch_client_id_here

# URL of the separate Authentication Microservice
VITE_AUTH_SERVICE_URL=http://localhost:3000

# URL of the achievement-management microservice
VITE_ACHIEVEMENT_MANAGEMENT_SERVICE_URL=http://localhost:3001

# URL of the bucket manager microservice
VITE_BUCKET_MANAGER_SERVICE_URL=http://localhost:3002

# Redirect URI (must be registered in Twitch Console)
# For local development, this is usually http://localhost:5173
# For production, it should be your Cloud Run frontend URL
VITE_TWITCH_REDIRECT_URI=http://localhost:5173

# Canonical frontend base URL used for shareable Twitch panel and extension links
VITE_FRONT_URL=http://localhost:5173
